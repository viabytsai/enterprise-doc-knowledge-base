# LLM API: compatible with the OpenAI Chat Completions protocol.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# auto: use cached BGE models when available, otherwise use demo fallback.
# full: allow sentence-transformers to download and load the configured BGE models.
# demo: always use the lightweight local fallback.
MODEL_MODE=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# auto: use Chroma when installed, otherwise use SQLite vector search.
VECTOR_STORE=auto
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=20
CONTEXT_TOP_K=5
MIN_RELEVANCE=0.18
MAX_FILE_MB=20

